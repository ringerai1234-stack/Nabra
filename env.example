# ============================================================================
# NABRA — environment variables
# ----------------------------------------------------------------------------
# Copy the names, never this file's values, into Railway → Variables.
# Never commit a filled-in .env. .gitignore already excludes it.
#
# REQUIRED  = the app will not run correctly without it
# BOOTSTRAP = set once, then delete from Railway after first boot
# OPTIONAL  = has a working default
# ============================================================================

# --- core ------------------------------------------------------------------
NODE_ENV=production                 # REQUIRED in production. Enables Secure cookies.
PORT=3000                           # OPTIONAL. Railway sets this itself.
DATABASE_URL=                       # REQUIRED. Neon connection string, include ?sslmode=require
SESSION_SECRET=                     # REQUIRED. 32+ random chars. Changing it logs everyone out.
                                    #   generate: openssl rand -base64 32

# --- first admin (BOOTSTRAP) -----------------------------------------------
# Used once on first boot to create your admin account.
# DELETE BOTH from Railway as soon as you have logged in successfully.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- payments --------------------------------------------------------------
PAYMENTS_MODE=off                   # off | paymob.  Anything but "paymob" skips the charge
                                    #   and goes straight to signup. That is TEST MODE.
                                    #   It MUST be paymob before you take real money.
PAYMOB_API_KEY=                     # REQUIRED when PAYMENTS_MODE=paymob
PAYMOB_INTEGRATION_ID=              # REQUIRED when PAYMENTS_MODE=paymob (card integration id)
PAYMOB_IFRAME_ID=                   # REQUIRED when PAYMENTS_MODE=paymob
PAYMOB_HMAC=                        # REQUIRED. Without it the webhook is not verified and
                                    #   anyone who finds the URL could activate an account.

# --- voice -----------------------------------------------------------------
VAPI_API_KEY=                       # REQUIRED to push call cost guards onto assistants.
                                    #   Without it the guards are NOT applied and Vapi's own
                                    #   600-second default cuts your calls at ten minutes.
VAPI_WEBHOOK_TOKEN=                 # REQUIRED. Shared secret checked on /api/vapi/webhook.
MAX_CALL_SECONDS=3600               # OPTIONAL. Runaway guard, not a conversation limit.
SILENCE_TIMEOUT_SECONDS=30          # OPTIONAL. Ends dead air and untranscribable noise.

# --- FX engine (second Railway service: npm run fx) ------------------------
FX_SERVICE_URL=                     # In the GATEWAY: full URL of the FX service.
FX_BUFFER_PCT=7                     # OPTIONAL. Margin on top of the CBE sell rate.
FX_REPRICE_PCT=2                    # OPTIONAL. Drift before the billing rate steps.
FX_ROUND=5                          # OPTIONAL. Round published EGP to nearest N.
FX_ALERT_WEBHOOK=                   # OPTIONAL. Slack/Teams URL for devaluation alerts.
FX_ALERT_EMAIL=                     # OPTIONAL. Your transactional email endpoint.
FX_PROVIDER_A=                      # OPTIONAL. Fallback rates API if CBE parsing fails.
FX_PROVIDER_A_KEY=
FX_PROVIDER_B=
FX_PROVIDER_B_KEY=

# --- Google sign-in --------------------------------------------------------
# OPTIONAL. Leave blank and the Google button does not appear; email and
# password sign-in always works either way.
#
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   Authorised redirect URI: https://YOURDOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- site ------------------------------------------------------------------
SITE_URL=                           # e.g. https://nabra.eg — used by robots.txt and sitemap.xml
